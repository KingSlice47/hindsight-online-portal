# Security headers applied to every response
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Astro's build output. Every filename here carries a content hash, so a
# changed file is always a changed URL and caching forever is safe. This
# covers the stylesheet and the Geist woff2 subsets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Hand-managed assets. These filenames are stable, so a one-year immutable
# cache would strand visitors on an old logo until it expired. A week is
# long enough to be useful and short enough to recover from.
/images/*
  Cache-Control: public, max-age=604800

/Favicon/*
  Cache-Control: public, max-age=604800
