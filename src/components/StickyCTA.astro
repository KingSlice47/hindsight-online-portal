---
import { Icon } from 'astro-icon/components';
---

<aside class="sticky-cta" id="stickyCta" aria-label="Contact shortcut">
  <p>Questions about your books, tax or compliance?</p>
  <a href="/contact" class="btn btn-primary">Talk to us</a>
  <button class="sticky-close" id="stickyCtaClose" type="button" aria-label="Dismiss">
    <Icon name="ph:x" />
  </button>
</aside>

<script>
  const cta = document.getElementById('stickyCta');
  const close = document.getElementById('stickyCtaClose');

  const dismissed = (() => {
    try {
      return sessionStorage.getItem('hs-cta-dismissed') === '1';
    } catch (e) {
      return false;
    }
  })();

  if (cta && !dismissed && 'IntersectionObserver' in window) {
    // Appears once the first screen has scrolled away, hides again over the
    // footer so it never covers the contact details.
    const hero = document.querySelector('#main-content > section');
    const footer = document.querySelector('.footer');

    let pastHero = false;
    let atFooter = false;
    const sync = () => cta.classList.toggle('is-visible', pastHero && !atFooter);

    if (hero) {
      new IntersectionObserver(
        ([entry]) => {
          pastHero = !entry.isIntersecting;
          sync();
        },
        { threshold: 0 },
      ).observe(hero);
    }

    if (footer) {
      new IntersectionObserver(
        ([entry]) => {
          atFooter = entry.isIntersecting;
          sync();
        },
        { rootMargin: '0px 0px -20% 0px' },
      ).observe(footer);
    }
  }

  close?.addEventListener('click', () => {
    cta?.classList.remove('is-visible');
    try {
      sessionStorage.setItem('hs-cta-dismissed', '1');
    } catch (e) {
      /* storage blocked: the bar stays dismissed for this page view */
    }
  });
</script>
