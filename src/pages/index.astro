---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const HERO_IMG =
  'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=80';

const team = [
  {
    name: 'Sipho Mampe',
    role: 'Chairman / Director',
    photo: '/images/sipho.jpg',
    width: 293,
    height: 450,
    bio: 'Brings extensive expertise in financial strategy and compliance. Sipho oversees operations and fosters relationships with Hindsight Consulting and its clients.',
  },
  {
    name: 'Dineo Rametsi',
    role: 'Accountant',
    photo: '/images/dineo.jpg',
    width: 450,
    height: 450,
    bio: 'A skilled leader in financial management, Dineo drives client account oversight and provides strategic direction to ensure operational excellence.',
  },
  {
    name: 'Dr Palesa Seele',
    role: 'Non-Executive Director',
    photo: '/images/dr-seele.jpg',
    width: 450,
    height: 450,
    bio: 'An esteemed academic and researcher with a passion for innovation and technology. A Fellow of Black Woman in Science.',
  },
];

const partners = [
  {
    name: 'Hindsight Consulting',
    note: 'Our parent company, and the group we deliver accounting and administration services within.',
  },
  {
    name: 'Tsogang Brands',
    note: 'Strategic partnership for comprehensive business solutions.',
  },
  {
    name: 'Afrilink Telecoms',
    note: 'Technology partner for digital solutions and web services.',
  },
  {
    name: 'Afrilink Corporation',
    note: 'Holding company with a diverse portfolio of services across the SADC region.',
  },
];

const stats = [
  { value: 9, suffix: '', label: 'Years in practice' },
  { value: 500, suffix: '+', label: 'Clients served' },
  { value: 6, suffix: '', label: 'Industries served' },
  { value: 4, suffix: '', label: 'Professional bodies' },
];
---

<BaseLayout
  title="Hindsight Online | Financial & Compliance Solutions for South African SMEs"
  description="Tech-driven financial & compliance solutions for South African SMEs. Accounting, tax services, business administration, and digital solutions since 2017."
  pageClass="page-home"
  currentPage="home"
  ogTitle="Hindsight Online | Financial & Compliance Solutions"
  preloadImage={HERO_IMG}
>
  {/* 1. Hero: asymmetric split */}
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <h1 class="h-display hero-title">Accounting and compliance, handled.</h1>
          <p class="lede">
            Cloud-based accounting, tax and business administration for South African SMEs.
            Registered, compliant, and run from Randburg since 2017.
          </p>
          <div class="hero-actions">
            <a href="/products" class="btn btn-primary">
              Explore our services
              <Icon name="ph:arrow-right" />
            </a>
            <a href="/contact" class="btn btn-secondary">Talk to us</a>
          </div>
        </div>

        <div class="hero-media">
          <img
            src={HERO_IMG}
            alt="A quiet, glass-partitioned professional office interior"
            width="1200"
            height="800"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  {/* 2. Credentials: logos only, directly under the hero */}
  <section class="credentials">
    <div class="container">
      <p class="credentials-label">Registered with and certified by</p>
      <div class="credentials-row">
        <span class="credential"
          ><span class="credential-mark">SAIPA</span>
        </span>
        <span class="credential">
          <img
            src="/images/ciba-logo.png"
            alt="Chartered Institute of Business Accountants"
            width="1622"
            height="1026"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="credential">
          <img
            src="/images/sait-membership-logo.png"
            alt="South African Institute of Tax Professionals"
            width="389"
            height="382"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="credential">
          <Icon name="ph:currency-circle-dollar" class="credential-svg" />
          <span class="credential-mark" style="margin-left:.55rem;">QuickBooks ProAdvisor</span>
        </span>
      </div>
    </div>
  </section>

  {/* 3. Services: bento, four cells, four items */}
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="h-section">Accounting, tax and compliance in one place</h2>
        <p class="body">
          The work most SMEs would rather not do in-house, run on QuickBooks Online and Draftworx by
          people who answer the phone.
        </p>
      </div>

      <div class="bento">
        <article class="bento-cell bento-cell--wide bento-cell--media" data-reveal>
          <img
            src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=900&q=80"
            alt="A laptop showing a financial reporting dashboard"
            width="900"
            height="600"
            loading="lazy"
            decoding="async"
          />
          <Icon name="ph:calculator" class="bento-icon" />
          <div class="bento-body">
            <h3 class="h-card">Accounting and bookkeeping</h3>
            <p>
              Monthly statements, transaction recording and bank reconciliations, kept current
              rather than caught up at year end.
            </p>
          </div>
        </article>

        <article class="bento-cell bento-cell--narrow bento-cell--tint" data-reveal style="--i:1">
          <Icon name="ph:receipt" class="bento-icon" />
          <div class="bento-body">
            <h3 class="h-card">Tax and SARS</h3>
            <p>VAT, PAYE, income tax returns and eFiling support.</p>
          </div>
        </article>

        <article class="bento-cell bento-cell--narrow" data-reveal style="--i:2">
          <Icon name="ph:buildings" class="bento-icon" />
          <div class="bento-body">
            <h3 class="h-card">Business administration</h3>
            <p>CIPC, COIDA, NCR and FSCA registrations and submissions.</p>
          </div>
        </article>

        <article class="bento-cell bento-cell--wide bento-cell--media" data-reveal style="--i:3">
          <img
            src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=900&q=80"
            alt="Two colleagues reviewing printed financial documents at a desk"
            width="900"
            height="600"
            loading="lazy"
            decoding="async"
          />
          <Icon name="ph:file-text" class="bento-icon" />
          <div class="bento-body">
            <h3 class="h-card">Financial statements</h3>
            <p>
              Annual financial statements and management accounts compiled in Draftworx, ready for
              your bank, funder or auditor.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* 4. Story: split, image and prose */}
  <section class="section section--sunk">
    <div class="container">
      <div class="split">
        <div class="split-media" data-reveal>
          <img
            src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=900&q=80"
            alt="A working meeting around a table with notebooks and documents"
            width="900"
            height="720"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div>
          <h2 class="h-section">Founded in Randburg, 2017</h2>
          <p class="body" style="margin-top:1.25rem;">
            Hindsight Online is a technology-driven accounting and business administration firm, and
            part of the Hindsight Consulting group. We deliver tailored financial and compliance
            solutions to small and medium-sized enterprises, and to clients of our parent company,
            including Tsogang Brands.
          </p>

          <div class="split-list">
            <div class="split-item">
              <Icon name="ph:cloud-check" />
              <div>
                <h3>Cloud-based by default</h3>
                <p>
                  QuickBooks Online and Draftworx, so your records are current and reachable from
                  anywhere.
                </p>
              </div>
            </div>
            <div class="split-item">
              <Icon name="ph:shield-check" />
              <div>
                <h3>Compliance first</h3>
                <p>
                  Regulatory deadlines tracked and filed on time, with the paperwork to show for it.
                </p>
              </div>
            </div>
            <div class="split-item">
              <Icon name="ph:handshake" />
              <div>
                <h3>One point of contact</h3>
                <p>You deal with the same people every month, not a ticket queue.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 5. Team: offset editorial row */}
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="h-section">The people on your account</h2>
        <p class="body">
          A small, experienced team. You will know who is doing your work and how to reach them.
        </p>
      </div>

      <div class="team-row">
        {
          team.map((member, i) => (
            <article class="team-member" data-reveal style={`--i:${i}`}>
              <div class="team-photo">
                <img
                  src={member.photo}
                  alt={member.name}
                  width={member.width}
                  height={member.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3>{member.name}</h3>
              <p class="team-role">{member.role}</p>
              <p>{member.bio}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 6. Partners: horizontal scroll-snap rail */}
  <section class="section section--sunk">
    <div class="container">
      <div class="section-head">
        <h2 class="h-section">Who we work with</h2>
      </div>

      <div class="rail">
        {
          partners.map((partner, i) => (
            <article class="rail-item">
              <span class="rail-index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{partner.name}</h3>
              <p>{partner.note}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 7. Stats: plain band, mono numerals, no card chrome */}
  <section class="container">
    <div class="stat-band">
      {
        stats.map((stat) => (
          <div>
            <div class="stat-value" data-count={stat.value} data-suffix={stat.suffix}>
              {stat.value}
              {stat.suffix}
            </div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  {/* 8. Closing CTA */}
  <section class="section">
    <div class="container">
      <div class="cta-panel on-accent">
        <h2 class="h-section">One platform for accounting, HR and admin</h2>
        <p>
          Our digital platform brings accounting, HR and business management together, built for
          South African SMEs.
        </p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">
            Talk to us
            <Icon name="ph:arrow-right" />
          </a>
          <a href="/pricing" class="btn btn-secondary">View pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
