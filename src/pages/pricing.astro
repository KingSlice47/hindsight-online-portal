---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const plans = [
  {
    name: 'Starter',
    amount: '1,500',
    featured: false,
    features: [
      'Basic bookkeeping',
      'Monthly financial statements',
      'VAT submissions',
      'Email support',
    ],
  },
  {
    name: 'Professional',
    amount: '2,500',
    featured: true,
    features: [
      'Complete bookkeeping',
      'Monthly financial statements',
      'VAT and PAYE submissions',
      'Income tax returns',
      'Business registration support',
      'Phone and email support',
    ],
  },
  {
    name: 'Enterprise',
    amount: '4,000',
    featured: false,
    features: [
      'Full accounting services',
      'Financial statement compilation',
      'Complete tax compliance',
      'Business administration',
      'Tender opportunities',
      'Priority support',
      'Dedicated account manager',
    ],
  },
];

const addons = [
  {
    name: 'Social Media Management',
    note: 'Professional social media presence across all platforms.',
    price: 'R800 / month',
  },
  {
    name: 'Website Development',
    note: 'Custom website design and development.',
    price: 'From R5,000',
  },
  {
    name: 'Mobile Apps',
    note: 'Access to our mobile accounting and HR applications.',
    price: 'R500 / month',
  },
];

const faqs = [
  {
    q: "What's included in all plans?",
    a: 'All plans include basic bookkeeping, monthly financial statements, and email support. Higher tiers add more comprehensive services.',
  },
  {
    q: 'Can I upgrade my plan?',
    a: 'Yes, you can upgrade or downgrade your plan at any time. Changes take effect at the next billing cycle.',
  },
  {
    q: 'Do you offer custom solutions?',
    a: 'Yes. We can tailor our services to meet your specific business requirements. Contact us for a custom quote.',
  },
  {
    q: 'What payment methods do you accept?',
    a: 'We accept bank transfers, debit orders, and credit card payments.',
  },
];
---

<BaseLayout
  title="Pricing | Hindsight Online"
  description="Transparent pricing for our financial and compliance solutions. Choose the plan that fits your business needs."
  pageClass="page-pricing"
  currentPage="pricing"
>
  {/* 1. Hero: type only */}
  <section class="hero hero--inner">
    <div class="container">
      <div class="hero-grid">
        <div>
          <h1 class="h-display hero-title">Pricing Made Simple</h1>
          <p class="lede">
            Transparent monthly plans. All of them include the core accounting and compliance work.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 2. Plans */}
  <section class="section">
    <div class="container">
      <div class="pricing-grid">
        {
          plans.map((plan, i) => (
            <article
              class={`plan${plan.featured ? ' plan--featured' : ''}`}
              data-reveal
              style={`--i:${i}`}
            >
              {plan.featured && <span class="plan-badge">Most popular</span>}
              <h2 class="h-card">{plan.name}</h2>

              <div class="plan-price">
                <span class="currency">R</span>
                <span class="amount">{plan.amount}</span>
                <span class="plan-period">/ month</span>
              </div>
              <p class="plan-note">Billed monthly.</p>

              <ul class="plan-features">
                {plan.features.map((f) => (
                  <li>
                    <Icon name="ph:check" />
                    {f}
                  </li>
                ))}
              </ul>

              <a href="/contact" class={`btn ${plan.featured ? 'btn-primary' : 'btn-secondary'}`}>
                Talk to us
              </a>
            </article>
          ))
        }
      </div>

      {/* 3. Add-ons: one container, dividers between rows only */}
      <div class="addons" data-reveal>
        {
          addons.map((addon) => (
            <div class="addon">
              <div>
                <h3>{addon.name}</h3>
                <p>{addon.note}</p>
              </div>
              <span class="addon-price">{addon.price}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 4. Questions */}
  <section class="section section--sunk">
    <div class="container">
      <div class="section-head">
        <h2 class="h-section">Questions</h2>
      </div>

      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>
                {item.q}
                <Icon name="ph:plus" />
              </summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* 5. Closing CTA */}
  <section class="section">
    <div class="container">
      <div class="cta-panel on-accent">
        <h2 class="h-section">Not sure which plan fits?</h2>
        <p>
          Tell us how many entities you run and where your books stand. We will quote against the
          actual work.
        </p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">
            Talk to us
            <Icon name="ph:arrow-right" />
          </a>
          <a href="/products" class="btn btn-secondary">Explore our services</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
