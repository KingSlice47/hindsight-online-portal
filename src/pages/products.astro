---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const IMG = 'https://images.unsplash.com/';
const q = '?auto=format&fit=crop&w=900&q=80';

// The two flagship services lead the page as wide horizontal cards.
const featured = [
  {
    title: 'Accounting & Bookkeeping',
    blurb: 'Comprehensive financial record keeping and accounting services tailored for SMEs.',
    // The previous image here was a US IRS tax form, which is the wrong
    // jurisdiction for a SARS practice. Swapped for a neutral document shot
    // until the commissioned photography lands.
    img: `${IMG}photo-1454165804606-c3d57bc86b40${q}`,
    alt: 'Two colleagues reviewing printed financial records at a desk',
    features: [
      'Monthly financial statements',
      'Transaction recording',
      'Bank reconciliations',
      'Financial reporting',
    ],
  },
  {
    title: 'Tax Services',
    blurb: 'Complete tax compliance including VAT, PAYE, Income Tax, and SARS eFiling services.',
    img: `${IMG}photo-1450101499163-c8848c66ca85${q}`,
    alt: 'A desk with documents and a calculator during tax preparation',
    features: ['VAT submissions', 'PAYE processing', 'Income tax returns', 'SARS eFiling support'],
  },
];

const services = [
  {
    title: 'Financial Statement Compilation',
    blurb: 'Professional financial statement preparation using Draftworx for accurate reporting.',
    img: `${IMG}photo-1460925895917-afdab827c52f${q}`,
    alt: 'A laptop displaying a financial reporting dashboard',
    features: [
      'Annual financial statements',
      'Management accounts',
      'Compliance reporting',
      'Audit preparation',
    ],
  },
  {
    title: 'Business Administration',
    blurb: 'Complete business compliance including CIPC, COIDA, NCR, and FSCA registrations.',
    img: `${IMG}photo-1507003211169-0a1dd7228f2d${q}`,
    alt: 'An organised office workspace used for business administration',
    features: [
      'Company registrations',
      'Compliance monitoring',
      'Regulatory submissions',
      'Licence applications',
    ],
  },
  {
    title: 'Tender Opportunities',
    blurb: 'Identification and management of tender opportunities through eTenders portal access.',
    img: `${IMG}photo-1560472354-b33ff0c44a43${q}`,
    alt: 'A boardroom table set for reviewing a tender proposal',
    features: [
      'Tender identification',
      'Proposal assistance',
      'Compliance checking',
      'Submission support',
    ],
  },
  {
    title: 'Social Media Engagement',
    blurb: 'Professional social media management across LinkedIn, Facebook, and Instagram.',
    img: `${IMG}photo-1611224923853-80b023f02d71${q}`,
    alt: 'A phone and laptop on a desk used for social media management',
    features: ['Content creation', 'Community management', 'Brand engagement', 'Analytics reporting'],
  },
  {
    title: 'Mobile Solutions',
    blurb: 'Mobile-first applications for accounting and HR management on the go.',
    img: `${IMG}photo-1563986768609-322da13575f3${q}`,
    alt: 'A person using a mobile phone to manage business finances',
    features: ['Mobile accounting', 'HR management', 'Real-time updates', 'Cloud synchronisation'],
  },
  {
    title: 'Digital Services via Afrilink Telecoms',
    blurb: 'Complete digital solutions including web development, hosting, and email services.',
    img: `${IMG}photo-1551288049-bebda4e38f71${q}`,
    alt: 'A monitor and keyboard in a modern digital services workspace',
    features: ['Website development', 'Domain and hosting', 'Email solutions', 'Technical support'],
  },
];

// Existing published claims, carried over unchanged. Flagged to the client as
// unverified rather than silently rewritten or deleted.
const stats = [
  { value: '500+', label: 'Clients served' },
  { value: '98%', label: 'Client satisfaction' },
  { value: '24/7', label: 'Cloud access' },
  { value: '100%', label: 'SARS compliant' },
];
---

<BaseLayout
  title="Our Services | Hindsight Online"
  description="Comprehensive financial and business solutions for South African SMEs including accounting, tax services, and business administration."
  pageClass="page-products"
  currentPage="products"
>
  {/* 1. Hero: type only */}
  <section class="hero hero--inner">
    <div class="container">
      <div class="hero-grid">
        <div>
          <h1 class="h-display hero-title">Our Services</h1>
          <p class="lede">
            Financial and business solutions for South African SMEs, delivered by a team you can
            reach.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 2. Flagship pair: wide horizontal cards */}
  <section class="section">
    <div class="container">
      <div class="service-grid">
        {
          featured.map((service, i) => (
            <article class="service-card service-card--featured" data-reveal style={`--i:${i}`}>
              <div class="service-media">
                <img
                  src={service.img}
                  alt={service.alt}
                  width="900"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="service-body">
                <h2 class="h-card">{service.title}</h2>
                <p>{service.blurb}</p>
                <ul class="service-features">
                  {service.features.map((f) => (
                    <li>
                      <Icon name="ph:check" />
                      {f}
                    </li>
                  ))}
                </ul>
                <a href="/contact" class="link-arrow">
                  Talk to us
                  <Icon name="ph:arrow-right" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 3. The remaining six, two columns */}
  <section class="section section--sunk">
    <div class="container">
      <div class="section-head">
        <h2 class="h-section">Everything else we handle</h2>
        <p class="body">
          Compliance, registrations and the digital work that sits alongside the books.
        </p>
      </div>

      <div class="service-grid">
        {
          services.map((service, i) => (
            <article class="service-card" data-reveal style={`--i:${i % 2}`}>
              <div class="service-media">
                <img
                  src={service.img}
                  alt={service.alt}
                  width="900"
                  height="506"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="service-body">
                <h3 class="h-card">{service.title}</h3>
                <p>{service.blurb}</p>
                <ul class="service-features">
                  {service.features.map((f) => (
                    <li>
                      <Icon name="ph:check" />
                      {f}
                    </li>
                  ))}
                </ul>
                <a href="/contact" class="link-arrow">
                  Talk to us
                  <Icon name="ph:arrow-right" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 4. Numbers: plain band, no card chrome */}
  <section class="container">
    <div class="stat-band">
      {
        stats.map((stat) => (
          <div>
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  {/* 5. Closing CTA */}
  <section class="section">
    <div class="container">
      <div class="cta-panel on-accent">
        <h2 class="h-section">Not sure which services you need?</h2>
        <p>Tell us how your business runs today and we will map the compliance work against it.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">
            Talk to us
            <Icon name="ph:arrow-right" />
          </a>
          <a href="/pricing" class="btn btn-secondary">View pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
